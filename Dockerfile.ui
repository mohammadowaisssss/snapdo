# =============================================================================
# Snapsec TaskTracker — UI / Frontend Dockerfile (Dockerfile.ui)
# Multi-stage build: Vite static bundle -> Hardened Nginx reverse-proxy & SPA
# =============================================================================

# Stage 1: Build the Frontend SPA
FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install --force

COPY index.html vite.config.ts tsconfig.json metadata.json ./
COPY firebase-applet-config.json* ./
COPY src/ ./src/

RUN npm run build

# Stage 2: Serve UI with Nginx & Reverse-Proxy /api/* to Backend Service
FROM nginx:1.27-alpine AS runner

# Install curl for container healthchecks
RUN apk add --no-cache curl
# Remove default nginx config and install Snapsec hardened config

RUN rm -f /etc/nginx/conf.d/default.conf
COPY docker/nginx.conf /etc/nginx/conf.d/snapsec.conf

# Copy compiled Vite frontend assets
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -fsS http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
