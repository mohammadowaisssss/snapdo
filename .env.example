# =============================================================================
# Snapsec TaskTracker — Environment Configuration (.env.example)
# Copy this file to .env before running `docker compose up -d --build`
# =============================================================================

# --- Host Port Mappings ---
# Frontend UI (Nginx) exposed on host port 4000
FRONTEND_PORT=4000
# Backend API service exposed on host port 5000
BACKEND_PORT=5000

# --- Service URLs ---
# Public URL used in invitation links and email headers (set to your reverse proxy domain)
APP_URL=http://localhost:4000
# Allowed CORS origin for direct API calls
CORS_ORIGIN=*

# --- Relational SQL Database (PostgreSQL 16) ---
PGHOST=db
PGPORT=5432
PGUSER=snapsec
PGPASSWORD=snapsec_prod_secret
PGDATABASE=snapsec_tasktracker

# --- Outbound Email / SMTP Delivery (Optional) ---
# Used for workspace member invitations and notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=mohammadowais616@gmail.com
