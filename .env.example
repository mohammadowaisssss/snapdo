# =============================================================================
# Snapsec TaskTracker — Environment Configuration (.env.example)
# Copy this file to .env before running `docker compose up -d --build`
# =============================================================================

# --- Host Port Mappings ---
# Frontend UI service exposed on host port 4000
FRONTEND_PORT=4000
# Backend API service exposed on host port 5000
BACKEND_PORT=5000

# --- Service URLs ---
# Public URL used in invitation links and email headers
APP_URL=http://localhost:4000
# Internal URL used by the Frontend Node server to proxy /api/* requests to Backend
BACKEND_URL=http://backend:5000
# Allowed CORS origin for direct API calls
CORS_ORIGIN=*

# --- Relational SQL Database (PostgreSQL & SQLite WAL) ---
PGHOST=db
PGPORT=5432
PGUSER=snapsec
PGPASSWORD=snapsec_prod_secret
PGDATABASE=snapsec_tasktracker
SQLITE_DB_PATH=/app/data/snapsec.sqlite

# --- Outbound Email / SMTP Delivery (Optional) ---
# Used for workspace member invitations if Gmail OAuth is not used
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=mohammadowais616@gmail.com
